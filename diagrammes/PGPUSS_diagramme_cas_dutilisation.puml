@startuml Diagramme_Cas_Utilisation_PGPUSS

skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam usecaseArrowColor #000000
skinparam actorBorderColor #000000
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseFontColor #000000
skinparam packageBorderColor #000000
skinparam packageFontColor #000000
skinparam rectangleBorderColor #000000
skinparam rectangleFontColor #000000
skinparam linetype ortho

left to right direction

title Diagramme de Cas d'Utilisation - PGPUSS

' ============================================================
'  ACTEURS
' ============================================================

actor "Usager\n(Plaignant)" as Usager
actor "PFE\n(Point Focal\nEtablissement)" as PFE
actor "Agent Affecté" as Agent
actor "Directeur\nd'Etablissement" as Directeur
actor "PFZS\n(Zone Sanitaire)" as PFZS
actor "PF-DDS\n(Departement)" as DDS
actor "PF-DQSS\n(National)" as DQSS
actor "Agent\nCall Center 136" as CallCenter
actor "Representant\nPNUSS" as PNUSS
actor "Auditeur" as Auditeur
actor "Administrateur\nNational" as Admin

' ============================================================
'  SYSTEME PGPUSS
' ============================================================

rectangle "Plateforme PGPUSS" {

    ' --- GESTION DES PLAINTES ---
    package "Gestion des Plaintes" {
        usecase "Deposer une plainte" as UC1
        usecase "Consulter statut\nplainte" as UC2
        usecase "Accuser reception\nresolution" as UC3
        usecase "Contester cloture" as UC4
        usecase "Retirer plainte" as UC5
        usecase "Completer informations" as UC6
    }

    ' --- TRAITEMENT PFE ---
    package "Traitement PFE" {
        usecase "Accuser reception\nplainte" as UC7
        usecase "Qualifier plainte" as UC8
        usecase "Affecter plainte" as UC9
        usecase "Traiter directement" as UC10
        usecase "Escalader direction" as UC11
        usecase "Proposer resolution" as UC12
        usecase "Cloturer plainte" as UC13
        usecase "Rouvrir plainte" as UC14
    }

    ' --- TRAITEMENT AGENT ---
    package "Traitement Agent" {
        usecase "Accepter affectation" as UC15
        usecase "Refuser affectation" as UC16
        usecase "Documenter actions" as UC17
        usecase "Soumettre rapport" as UC18
        usecase "Demander extension\ndelai" as UC19
    }

    ' --- DIRECTION ---
    package "Direction Etablissement" {
        usecase "Valider resolution" as UC20
        usecase "Infirmer resolution" as UC21
        usecase "Escalader DDS" as UC22
        usecase "Decision disciplinaire" as UC23
        usecase "Consulter tableau\nde bord" as UC24
    }

    ' --- ESCALADE ZONE ---
    package "Escalade Zone Sanitaire" {
        usecase "Superviser PFE" as UC25
        usecase "Recevoir escalade" as UC26
        usecase "Instruire enquete" as UC27
        usecase "Escalader DDS" as UC28
        usecase "Rendre compte" as UC29
    }

    ' --- DDS ---
    package "Direction Departementale" {
        usecase "Recevoir dossier\nescalade" as UC30
        usecase "Diligenter enquete" as UC31
        usecase "Affecter inspecteur" as UC32
        usecase "Arbitrer" as UC33
        usecase "Escalader Ministere" as UC34
        usecase "Notifier parties" as UC35
        usecase "Cloturer dossier" as UC36
    }

    ' --- NATIONAL ---
    package "Niveau National" {
        usecase "Superviser plaintes" as UC37
        usecase "Declencher audit" as UC38
        usecase "Emettre injonction" as UC39
        usecase "Produire rapport\nnational" as UC40
        usecase "Cloturer definitivement" as UC41
    }

    ' --- CALL CENTER ---
    package "Call Center 136" {
        usecase "Recevoir appel" as UC42
        usecase "Saisir plainte" as UC43
        usecase "Communiquer ticket" as UC44
        usecase "Assister suivi" as UC45
    }

    ' --- PNUSS ---
    package "PNUSS Mediation" {
        usecase "Suivre plaintes" as UC46
        usecase "Participer enquete" as UC47
        usecase "Intervenir mediation" as UC48
        usecase "Generer statistiques" as UC49
        usecase "Alerter hierarchie" as UC50
        usecase "Plaidoyer national" as UC51
    }

    ' --- ADMINISTRATION ---
    package "Administration" {
        usecase "Gerer utilisateurs" as UC52
        usecase "Gerer referentiels" as UC53
        usecase "Configurer taxonomie" as UC54
        usecase "Superviser systeme" as UC55
        usecase "Generer rapports" as UC56
    }

    ' --- NOTIFICATIONS ---
    package "Notifications" {
        usecase "Envoyer notification" as UC57
        usecase "Relancer notification" as UC58
        usecase "Marquer comme lue" as UC59
    }

    ' --- AUTHENTIFICATION ---
    package "Authentification" {
        usecase "S'authentifier" as UC60
        usecase "Activer MFA" as UC61
        usecase "Modifier profil" as UC62
        usecase "Deconnecter" as UC63
    }

    ' --- ANALYTIQUE ---
    package "Analytique" {
        usecase "Generer tableau\nde bord" as UC64
        usecase "Exporter donnees" as UC65
        usecase "Detecter tendances" as UC66
    }
}

