# Modèle pour un lancement manuel du backend Django.
# Ne jamais commiter le fichier backend/.env.

DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=True
DATABASE_URL=

# Redis : localhost en manuel ; `redis://redis:6379/0` en Docker Compose.
REDIS_URL=redis://localhost:6379/0

# Uploads et comportement serverless.
FAST_COMPLAINT_CREATE=False
VERCEL_MAX_UPLOAD_BYTES=52428800

# Stockage des pièces jointes et messages vocaux : local via FileSystemStorage.
# En Docker, les fichiers sont persistés par le volume backend_media.

# Notifications e-mail.
EMAIL_ALERTS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PGP-USS <noreply@pgpuss.local>
SITE_NAME=PGP-USS Santé Bénin

# SMS : mock ou webhook.
SMS_PROVIDER_MODE=mock
SMS_WEBHOOK_URL=
SMS_SENDER=PGPUSS
# OTP Firebase : facultatif, uniquement si l’authentification Firebase est activée.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FB_VERIFY_TOKEN=

# WhatsApp via OpenWA (alternative à l’API Meta Cloud).
# En manuel, OpenWA et Django tournent sur l’hôte local.
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=pgpuss-whatsapp
OPENWA_WEBHOOK_SECRET=replace-with-random-hmac-secret
WA_VERIFY_TOKEN=replace-with-random-verify-token
PGPUSS_WEBHOOK_URL=http://localhost:8000/api/complaints/webhooks/whatsapp/
OPENWA_SESSION_NAME=pgpuss-whatsapp
