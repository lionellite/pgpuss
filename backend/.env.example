# Copier vers backend/.env pour le développement local
# Ne jamais commiter le fichier .env

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# PostgreSQL (local ou Supabase pooler port 6543)
# DATABASE_URL=postgresql://user:pass@host:6543/dbname

# Stockage des pièces jointes et messages vocaux (obligatoire sur Vercel)
# Dashboard Cloudinary → Product environment → API environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── Email SMTP Gmail ───────────────────────────────────────────────
EMAIL_ALERTS_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-compte@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-gmail
DEFAULT_FROM_EMAIL=PGP-USS <votre-compte@gmail.com>

# ─── SMS ────────────────────────────────────────────────────────────
# mock = journalise uniquement | webhook = API externe
SMS_PROVIDER_MODE=mock
# SMS_WEBHOOK_URL=https://votre-fournisseur-sms.example/send

# ─── Firebase Authentication (OTP SMS) ──────────────────────────────
# Créer un projet Firebase → Authentication → Phone → activer
# Télécharger la clé de compte de service (JSON) :
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ou GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/serviceAccountKey.json
# FIREBASE_PROJECT_ID=votre-projet-firebase

# ─── WhatsApp via OpenWA (recommandé) ─────────────────────────────
# Backend local : python manage.py runserver (port 8000)
# OpenWA local  : cd OpenWA && npm install && npm run dev
# ou OpenWA Docker seul : docker compose -f docker-compose.openwa.yml up -d
# Config : ./scripts/setup_openwa_whatsapp.sh
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=pgpuss_openwa_secret_change_me
