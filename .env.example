# Fichier racine utilisé par docker compose.
# Copier vers .env puis remplacer toutes les valeurs sensibles.

DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=False
DATABASE_URL=

# Redis : service Docker `redis`, ou localhost en lancement manuel.
REDIS_URL=redis://redis:6379/0

# OpenWA / WhatsApp.
OPENWA_API_URL=http://openwa:2785/api
OPENWA_API_KEY=replace-with-openwa-api-key
OPENWA_SESSION_ID=pgpuss-whatsapp
OPENWA_WEBHOOK_SECRET=replace-with-random-hmac-secret
WA_VERIFY_TOKEN=replace-with-random-verify-token
PGPUSS_WEBHOOK_URL=http://backend:8000/api/complaints/webhooks/whatsapp/
OPENWA_SESSION_NAME=pgpuss-whatsapp

# Notifications e-mail (laisser en console/mock pour le développement).
EMAIL_ALERTS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PGP-USS <noreply@pgpuss.local>
SITE_NAME=PGP-USS Santé Bénin

# SMS : mock ou webhook.
SMS_PROVIDER_MODE=mock
SMS_WEBHOOK_URL=
SMS_SENDER=PGPUSS
# OTP Firebase : facultatif, uniquement si l’authentification Firebase est activée.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FB_VERIFY_TOKEN=

# Parcours d’upload serverless.
FAST_COMPLAINT_CREATE=False
VERCEL_MAX_UPLOAD_BYTES=52428800
